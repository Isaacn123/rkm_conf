## App
# Token required to view submissions:
#   GET /api/form/submissions  (header: X-Admin-Token)
ADMIN_TOKEN=change-me-long-random

## Brevo (Sendinblue) transactional email
# Create an API key in Brevo and paste it here.
BREVO_API_KEY=change-me-brevo-api-key
# Sender identity (must be allowed/verified in Brevo)
BREVO_SENDER_EMAIL=no-reply@robertkayanjaministries.ug
BREVO_SENDER_NAME=RKMConf
# Admin notification recipient
ADMIN_NOTIFY_EMAIL=church@robertkayanjaministries.ug

## MySQL
MYSQL_DATABASE=rkmconf
MYSQL_USER=rkmconf
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

